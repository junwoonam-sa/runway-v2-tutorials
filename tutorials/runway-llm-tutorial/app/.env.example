# 로컬 개발용. 이 파일을 .env로 복사해서 값을 채우세요.
# .env는 절대 커밋하지 않습니다 — 클러스터에서는 이 값들이 OpenBao에서 옵니다.

# --- 필수 3개 ---------------------------------------------------------------
# 인클러스터:  http://litellm.runway-applications.svc.cluster.local:4000/v1
# 게이트웨이:  https://llm.<도메인>/v1
LLM_BASE_URL=https://llm.example.com/v1

# 게이트웨이가 실제로 publish한 이름. 추측하지 말고 확인하세요:
#   curl -H "Authorization: Bearer $LLM_API_KEY" $LLM_BASE_URL/models
LLM_MODEL=

# 콘솔 → 액세스 키(Access keys) → LLM API 키. 'sk-'로 시작합니다.
# Runway API 키('eyJ...')는 다른 자격증명이며 게이트웨이가 거부합니다.
LLM_API_KEY=

# --- 선택 -------------------------------------------------------------------
LLM_SYSTEM_PROMPT=너는 Runway 플랫폼을 안내하는 도우미다. 모르면 모른다고 답한다.
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=0

# Stage 4부터. 비어 있으면 문서·검색 기능 전체가 꺼집니다.
# 인클러스터: http://<Qdrant 릴리스명>.<프로젝트>.svc.cluster.local:6333
# QDRANT_URL=
# QDRANT_COLLECTION=tutorial-docs

# auto | gateway | local  (auto는 게이트웨이를 먼저 재보고 안 되면 로컬로 갑니다)
# EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL_GATEWAY=BAAI/bge-m3
# EMBEDDING_MODEL_LOCAL=intfloat/multilingual-e5-small
# EMBEDDING_CACHE_DIR=/data/embedding-cache

# MCP 서버를 끄면 문서 기능이 통째로 사라집니다.
# MCP_ENABLED=true

# 공유 비밀번호. Runway는 애플리케이션 호스트 앞에 로그인을 붙여 주지 않습니다.
# ACCESS_PASSWORD=
